DB_PATH="../web/prisma/dev.db"

SOURCE_PDF="../doc/fde.pdf"
SOURCE_OUT_DIR="../data/source"
PDF_PARSER_VERSION="pymupdf-1"
PDF_EXPECTED_PAGES="151"
PDF_EXPECTED_CHAPTERS="12"
PDF_IGNORE_PAGES="1-3"

# ---------- LLM 配置 ----------
# 方式 A：普通 OpenAI 兼容接口（DeepSeek / 腾讯混元 / 自建网关）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 方式 B：OpenCode Go（填写后优先于方式 A）
# 控制台：https://opencode.ai/console
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://opencode.ai/inference/go/openai/v1"
# OPENAI_MODEL="deepseek-v4.1-flash"
# 可选：固定会话 ID，便于 OpenCode 做 prompt 缓存
# OPENCODE_SESSION="fde-exam-generator"

LLM_TEMPERATURE="0.4"
LLM_TIMEOUT_SECONDS="120"
LLM_MAX_RETRIES="3"
LLM_USER_AGENT="fde-exam-generator/0.1"

DEDUP_HAMMING_THRESHOLD="4"
DEDUP_JACCARD_THRESHOLD="0.85"
DEDUP_CLAIM_SIMILARITY="0.95"

QUALITY_MIN_OVERALL="4.0"
QUALITY_MIN_CORE="4"
BLIND_SOLVE_SAMPLES_MULTIPLE="3"

TARGET_CANDIDATES="150"
